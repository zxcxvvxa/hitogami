{
  "log": {
    "level": "warn",
    "output": "stderr",
    "timestamp": false
  },
  "inbounds": [
    {
      "tag": "vless-ws-in",
      "type": "vless",
      "listen": "127.0.0.1",
      "listen_port": 10001,
      "users": [
        {
          "uuid": "hitogami"
        }
      ],
      "multiplex": {
        "enabled": true,
        "padding": true
      },
      "transport": {
        "type": "ws",
        "path": "/hitogami",
        "max_early_data": 2048,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct",
      "domain_strategy": "AsIs"
    }
  ],
  "route": {
    "final": "direct"
  }
}
